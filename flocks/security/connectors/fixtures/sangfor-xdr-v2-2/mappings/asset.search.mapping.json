{
  "version": "connector.mapping.v1",
  "capability": "asset.search",
  "target": "assets",
  "source": {
    "items_path": "items"
  },
  "include_raw_data": true,
  "include_normalized_data": true,
  "fields": [
    { "raw": ["id", "assetId", "asset_id", "hostId", "host_id", "uuid", "agentId", "ip", "hostIp", "assetIp"], "target": "id" },
    { "raw": ["name", "assetName", "asset_name", "hostname", "hostName", "machine", "machine_name", "ip", "hostIp", "assetIp"], "target": "name", "default": "Unknown Asset" },
    {
      "raw": ["type", "asset_type", "assetType", "host_type", "assetClass", "asset_section"],
      "target": "asset_type",
      "default": "endpoint",
      "enum_default": "other",
      "enum": {
        "server": "server",
        "host": "server",
        "endpoint": "endpoint",
        "pc": "endpoint",
        "terminal": "endpoint",
        "network_device": "network_device",
        "security_device": "security_device",
        "web_app": "web_app",
        "api": "api",
        "database": "database",
        "cloud_resource": "cloud_resource",
        "other": "other"
      }
    },
    { "raw": ["ip", "hostIp", "host_ip", "assetIp", "asset_ip", "privateIp", "private_ip", "publicIp", "public_ip"], "target": "ip" },
    { "raw": ["hostname", "hostName", "machine", "machine_name"], "target": "hostname" },
    { "raw": ["domain", "domainName"], "target": "domain" },
    { "raw": ["department", "departmentName", "business_system", "system"], "target": "business_system" },
    { "raw": ["owner", "manager", "business_owner"], "target": "business_owner" },
    {
      "raw": ["importance", "criticality", "level", "assetLevel"],
      "target": "importance",
      "default": "medium",
      "enum_default": "medium",
      "enum": {
        "0": "low",
        "1": "low",
        "2": "medium",
        "3": "high",
        "4": "critical",
        "low": "low",
        "medium": "medium",
        "high": "high",
        "critical": "critical"
      }
    },
    {
      "raw": ["exposure", "exposure_level", "isPublic", "is_public"],
      "target": "exposure_level",
      "default": "unknown",
      "enum_default": "unknown",
      "enum": {
        "true": "external",
        "false": "internal",
        "1": "external",
        "0": "internal",
        "internal": "internal",
        "external": "external",
        "unknown": "unknown"
      }
    },
    { "raw": ["services", "service", "serviceName"], "target": "services", "default": [], "transform": "list" },
    { "raw": ["tags", "labels", "riskTag"], "target": "tags", "default": [], "transform": "list" },
    { "raw": ["description", "remark", "memo"], "target": "description" }
  ]
}
